{
 "doctype": "DocType",
 "name": "Selling Price Rule",
 "module": "Selling Pricing Engine",
 "engine": "InnoDB",
 "custom": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "field_order": [
  "company",
  "price_list",
  "disabled",
  "item_code",
  "warehouse",
  "uom",
  "valid_from",
  "valid_upto",
  "calculation_mode",
  "calculation_method",
  "calculation_value",
  "rounding_mode",
  "rounding_method",
  "rounding_increment",
  "import_revision"
 ],
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "price_list",
   "fieldtype": "Link",
   "label": "Price List",
   "options": "Price List",
   "reqd": 1
  },
  {
   "fieldname": "disabled",
   "fieldtype": "Check",
   "label": "Disabled",
   "default": "0"
  },
  {
   "fieldname": "item_code",
   "fieldtype": "Link",
   "label": "Item Code",
   "options": "Item",
   "in_list_view": 1
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Link",
   "label": "Warehouse",
   "options": "Warehouse",
   "in_list_view": 1,
   "description": "Use a confirmed HQ-to-Warehouse mapping. Independent Branch policies are Phase 2."
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Uom",
   "options": "UOM"
  },
  {
   "fieldname": "valid_from",
   "fieldtype": "Date",
   "label": "Valid From",
   "default": "Today",
   "reqd": 1
  },
  {
   "fieldname": "valid_upto",
   "fieldtype": "Date",
   "label": "Valid Upto"
  },
  {
   "fieldname": "calculation_mode",
   "fieldtype": "Select",
   "label": "Calculation Mode",
   "options": "Use Default\nOverride",
   "default": "Use Default",
   "reqd": 1
  },
  {
   "fieldname": "calculation_method",
   "fieldtype": "Select",
   "label": "Calculation Method",
   "options": "Markup Percentage\nTarget Gross Margin\nFixed Addition\nFixed Selling Price",
   "default": "Markup Percentage",
   "reqd": false
  },
  {
   "fieldname": "calculation_value",
   "fieldtype": "Float",
   "label": "Calculation Value",
   "precision": "9",
   "default": "0",
   "description": "Percentage or amount. Explicit 0 is valid for markup/addition. Fixed prices require a positive value."
  },
  {
   "fieldname": "rounding_mode",
   "fieldtype": "Select",
   "label": "Rounding Mode",
   "options": "Use Default\nOverride",
   "default": "Use Default",
   "reqd": 1
  },
  {
   "fieldname": "rounding_method",
   "fieldtype": "Select",
   "label": "Rounding Method",
   "options": "No Rounding\nNearest\nRound Up\nRound Down",
   "default": "No Rounding"
  },
  {
   "fieldname": "rounding_increment",
   "fieldtype": "Float",
   "label": "Rounding Increment",
   "default": "1",
   "precision": "9"
  },
  {
   "fieldname": "import_revision",
   "fieldtype": "Link",
   "label": "Import Revision",
   "options": "Selling Price Revision",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "hash"
}
