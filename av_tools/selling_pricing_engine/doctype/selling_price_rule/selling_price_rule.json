  "rule_details_section",
  "company",
  "price_list",
  "rule_details_column",
  "disabled",
  "applies_to_section",
  "item_code",
  "uom",
  "applies_to_column",
  "warehouse",
  "branch",
  "supplier_group_section",
  "supplier",
  "supplier_group_column",
  "item_group",
  "include_child_groups",
  "validity_section",
  "valid_from",
  "validity_column",
  "valid_upto",
  "calculation_section",
  "calculation_mode",
  "calculation_method",
  "calculation_column",
  "calculation_value",
  "cost_source_section",
  "cost_basis",
  "rounding_section",
  "rounding_mode",
  "rounding_method",
  "rounding_column",
  "rounding_increment",
  "origin_section",
  "import_revision"
 ],
 "fields": [
  {
   "fieldname": "rule_details_section",
   "fieldtype": "Section Break",
   "label": "Rule Details"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "price_list",
   "fieldtype": "Link",
   "label": "Price List",
   "options": "Price List",
   "reqd": 1
  },
  {
   "fieldname": "rule_details_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "disabled",
   "fieldtype": "Check",
   "label": "Disabled",
   "default": "0"
  },
  {
   "fieldname": "applies_to_section",
   "fieldtype": "Section Break",
   "label": "Applies To"
  },
  {
   "fieldname": "item_code",
   "fieldtype": "Link",
   "label": "Item Code",
   "options": "Item",
   "in_list_view": 1
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Uom",
   "options": "UOM"
  },
  {
   "fieldname": "applies_to_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Link",
   "label": "Warehouse",
   "options": "Warehouse",
   "in_list_view": 1,
   "description": "Optional Warehouse scope. A mapped Branch supplies the independent fallback tier."
  },
  {
   "fieldname": "branch",
   "label": "Branch",
   "fieldtype": "Link",
   "options": "Branch"
  },
  {
   "fieldname": "supplier_group_section",
   "fieldtype": "Section Break",
   "label": "Supplier & Item Group Conditions"
  },
  {
   "fieldname": "supplier",
   "label": "Supplier",
   "fieldtype": "Link",
   "options": "Supplier"
  },
  {
   "fieldname": "supplier_group_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "item_group",
   "label": "Item Group",
   "fieldtype": "Link",
   "options": "Item Group"
  },
  {
   "fieldname": "include_child_groups",
   "label": "Include Child Item Groups",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "validity_section",
   "fieldtype": "Section Break",
   "label": "Validity"
  },
  {
   "fieldname": "valid_from",
   "fieldtype": "Date",
   "label": "Valid From",
   "default": "Today",
   "reqd": 1
  },
  {
   "fieldname": "validity_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "valid_upto",
   "fieldtype": "Date",
   "label": "Valid Upto"
  },
  {
   "fieldname": "calculation_section",
   "fieldtype": "Section Break",
   "label": "Calculation"
  },
  {
   "fieldname": "calculation_mode",
   "fieldtype": "Select",
   "label": "Calculation Mode",
   "options": "Use Default\nOverride",
   "default": "Use Default",
   "reqd": 1
  },
  {
   "fieldname": "calculation_method",
   "fieldtype": "Select",
   "label": "Calculation Method",
   "options": "Markup Percentage\nTarget Gross Margin\nFixed Addition\nFixed Selling Price",
   "default": "Markup Percentage",
   "reqd": false
  },
  {
   "fieldname": "calculation_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "calculation_value",
   "fieldtype": "Float",
   "label": "Calculation Value",
   "precision": "9",
   "default": "0",
   "description": "Percentage or amount. Explicit 0 is valid for markup/addition. Fixed prices require a positive value."
  },
  {
   "fieldname": "cost_source_section",
   "fieldtype": "Section Break",
   "label": "Cost Source"
  },
  {
   "fieldname": "cost_basis",
   "label": "Cost Basis",
   "fieldtype": "Select",
   "default": "Use Default",
   "options": "Use Default\nLatest Submitted Purchase Invoice\nCurrent Purchase Invoice\nCurrent Purchase Receipt\nLatest Submitted Purchase Receipt\nLatest Purchase Rate\nSupplier Latest Purchase Rate\nValuation Rate\nWarehouse Valuation Rate"
  },
  {
   "fieldname": "rounding_section",
   "fieldtype": "Section Break",
   "label": "Rounding"
  },
  {
   "fieldname": "rounding_mode",
   "fieldtype": "Select",
   "label": "Rounding Mode",
   "options": "Use Default\nOverride",
   "default": "Use Default",
   "reqd": 1
  },
  {
   "fieldname": "rounding_method",
   "fieldtype": "Select",
   "label": "Rounding Method",
   "options": "No Rounding\nNearest\nRound Up\nRound Down",
   "default": "No Rounding"
  },
  {
   "fieldname": "rounding_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "rounding_increment",
   "fieldtype": "Float",
   "label": "Rounding Increment",
   "default": "1",
   "precision": "9"
  },
  {
   "fieldname": "origin_section",
   "fieldtype": "Section Break",
   "label": "Origin",
   "collapsible": 1
  },
  {
   "fieldname": "import_revision",
   "fieldtype": "Link",
   "label": "Import Revision",
   "options": "Selling Price Revision",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "hash",
 "allow_import": 1
}
