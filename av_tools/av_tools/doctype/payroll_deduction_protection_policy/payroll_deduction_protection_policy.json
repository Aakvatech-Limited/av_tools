{
  "doctype": "DocType",
  "name": "Payroll Deduction Protection Policy",
  "module": "Av Tools",
  "custom": 0,
  "is_submittable": 0,
  "istable": 0,
  "autoname": "field:company",
  "field_order": [
    "company",
    "enabled",
    "protection_basis",
    "basic_salary_component",
    "protected_percentage",
    "minimum_protected_amount",
    "deduction_rules"
  ],
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1,
      "unique": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "protection_basis",
      "fieldtype": "Select",
      "label": "Protection Calculation Basis",
      "options": "Gross Pay\nBasic Salary Component",
      "default": "Gross Pay",
      "reqd": 1
    },
    {
      "fieldname": "basic_salary_component",
      "fieldtype": "Link",
      "label": "Basic Salary Component",
      "options": "Salary Component",
      "depends_on": "eval:doc.protection_basis=='Basic Salary Component'",
      "mandatory_depends_on": "eval:doc.protection_basis=='Basic Salary Component'"
    },
    {
      "fieldname": "protected_percentage",
      "fieldtype": "Percent",
      "label": "Protected Earnings Percentage",
      "default": "33.333333",
      "reqd": 1
    },
    {
      "fieldname": "minimum_protected_amount",
      "fieldtype": "Currency",
      "label": "Minimum Protected Amount",
      "default": "0"
    },
    {
      "fieldname": "deduction_rules",
      "fieldtype": "Table",
      "label": "Recoverable Deductions",
      "options": "Payroll Deduction Protection Rule"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "Payroll Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1,
      "report": 1
    }
  ],
  "links": [],
  "actions": []
}
